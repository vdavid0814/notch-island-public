<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unsandboxed: the key interceptor (CGEventTap), DisplayServices/MediaRemote resolved at
	     runtime and the MediaRemote adapter child process are all unavailable in the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Apple Events to Music and Spotify (Now Playing without the adapter). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
